{
  "manifest_version": 3,
  "name": "Netflix Ambilight",
  "version": "0.1.4",
  "description": "Entoure les vidéos Netflix d'un halo lumineux ambiant (style Ambilight / Ambient Light for YouTube).",
  "permissions": ["storage"],
  "host_permissions": ["https://www.netflix.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Netflix Ambilight"
  },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*", "https://netflix.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
